BOT_TOKEN=your_botfather_token
APP_ENV=development
# Login for the panel. The password needs 12 to 256 characters. Generate one with: openssl rand -hex 24
# Use only letters and digits: compose changes values that contain $ or " #".
# Changing it ends existing sessions, but only after `docker compose up -d`: `restart` keeps the old values.
# Keep this file private: chmod 600 .env
PANEL_USER=admin
PANEL_PASSWORD=change-me-to-a-long-random-password
# Production only: the panel's domain, without https:// or a port. Other domains are refused.
# PANEL_HOST=panel.example.com
# The development proxy expects port 3000: change front/vite.config.ts and the port in Dokploy's Domains tab too
API_PORT=3000
# DATABASE_PATH=./data/development.sqlite
